{
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "VerificationCode",
      "required": ["_id", "code_hash", "attempts", "created_at", "expires_at"],
      "additionalProperties": false,
      "properties": {
        "_id": { "bsonType": "binData", "description": "ID of the user the code was sent to" },
        "code_hash": { "bsonType": "binData", "description": "SHA-256 of the six-digit code" },
        "attempts": { "bsonType": "int", "minimum": 0 },
        "created_at": { "bsonType": "date" },
        "expires_at": { "bsonType": "date" }
      }
    }
  },
  "indexes": [
    {
      "key": { "expires_at": 1 },
      "name": "expires_at_ttl",
      "expireAfterSeconds": 0
    }
  ]
}

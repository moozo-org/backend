PORT=8080
PRODUCTION=false

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=moozo

# Brevo transactional email. Leave BREVO_API_KEY empty in development to log
# verification codes instead; it is required when PRODUCTION=true. The sender
# must be verified in the Brevo account.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Moozo
